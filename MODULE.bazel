module(
    name = "android_env",
    version = "2.0.0",
)

# Core rules
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "protobuf", version = "31.1")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_java", version = "9.0.3")
bazel_dep(name = "rules_android", version = "0.6.6")
bazel_dep(name = "rules_kotlin", version = "2.1.8")
bazel_dep(name = "rules_jvm_external", version = "6.7")

# Keep protobuf aligned with rules_android's ResourceProcessorBusyBox runtime (4.31.1)
# and the prebuilt toolchains_protoc v31.1 binary.
single_version_override(
    module_name = "protobuf",
    version = "31.1",
)

# Hermetic Pre-built Protoc Toolchain
bazel_dep(name = "toolchains_protoc", version = "0.6.1")

protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc")
protoc.toolchain(
    google_protobuf = "protobuf",
    version = "v31.1",
)
use_repo(protoc, "toolchains_protoc_hub")

register_toolchains("@toolchains_protoc_hub//:all")

# Hermetic Python Toolchain
python = use_extension("@rules_python//python/extensions:python.bzl", "python")

# rules_python 2.2.0 (last version compatible with Bazel 7.4.0) maps "3.15" to
# pre-release 3.15.0a8, which is ABI-incompatible with stable cp315 wheels.
# Register stable CPython 3.15.2 until Bazel and rules_python are upgraded.
python.single_version_override(
    python_version = "3.15.2",
    sha256 = {
        "aarch64-apple-darwin": "1b1b03fca8aa351698403f3d100ee83db7a5d99748fc7707681ac31a6a846ad9",
        "aarch64-pc-windows-msvc": "8218fe27434a1d69d54deea9caa338cd2351f65aaf2b409bcb6b25d009f53258",
        "aarch64-unknown-linux-gnu": "0f23351c03b39beb880de668976074fcc3c082d9c3b03d0b43185632b2b270a0",
        "x86_64-apple-darwin": "6ec04346b578656b5d5597144cbe0f4773acea6af6048cb8fe0cac3e92c702ac",
        "x86_64-pc-windows-msvc": "02e532b60e720aa3d77e757c349ae9cc945441c05851fa646336fc9ff0403041",
        "x86_64-unknown-linux-gnu": "7b03163a980c607ba8194709d4a4086735a7a9c488cc475b098157306927b36b",
    },
    urls = [
        "https://github.com/astral-sh/python-build-standalone/releases/download/20261026/cpython-{python_version}+20261026-{platform}-install_only_stripped.tar.gz",
    ],
)
python.toolchain(
    python_version = "3.11",
)
use_repo(python, "python_3_11")

# Pip dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.11",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pip")

# Hermetic TypeScript and JavaScript Toolchain
bazel_dep(name = "aspect_rules_esbuild", version = "0.25.1")
bazel_dep(name = "aspect_rules_ts", version = "3.5.0")
bazel_dep(name = "aspect_rules_js", version = "2.2.0")
bazel_dep(name = "rules_nodejs", version = "6.3.3")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "20.18.0")
use_repo(node, "nodejs_toolchains")

register_toolchains("@nodejs_toolchains//:all")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps()
use_repo(rules_ts_ext, "npm_typescript")
# npm dependencies for the Playground frontend.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//android_env/playground/frontend:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# Android SDK & Maven dependencies for the on-device AndroidEnv server APK.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.override(
    coordinates = "com.google.protobuf:protobuf-javalite",
    target = "@protobuf//:protobuf_javalite",
)
maven.install(
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "androidx.activity:activity:1.9.3",
        "androidx.annotation:annotation:1.9.1",
        "androidx.core:core:1.13.1",
        "com.google.errorprone:error_prone_annotations:2.36.0",
        "org.java-websocket:Java-WebSocket:1.5.7",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
use_repo(maven, "maven")

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
use_repo(android_sdk_repository_extension, "androidsdk")

register_toolchains("@androidsdk//:sdk-toolchain", "@androidsdk//:all")
