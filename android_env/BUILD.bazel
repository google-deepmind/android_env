load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "env_interface",
    srcs = ["env_interface.py"],
    deps = [
        "//android_env/proto:adb_py_pb2",
        "@pip//dm_env",
        "@pip//numpy",
    ],
)

py_library(
    name = "loader",
    srcs = ["loader.py"],
    deps = [
        ":env_interface",
        "//android_env/components:android_device_loader",
        "//android_env/components:config_classes",
        "//android_env/proto:task_py_pb2",
        "//android_env/rl:environment",
        "//android_env/wrappers:task_wrapper",
        "@pip//absl_py",
        "@pip//protobuf",
    ],
)

py_test(
    name = "loader_test",
    srcs = ["loader_test.py"],
    legacy_create_init = False,
    deps = [
        ":loader",
        "//android_env/components:android_device_loader",
        "//android_env/components:config_classes",
        "//android_env/proto:task_py_pb2",
        "//android_env/rl:environment",
        "//android_env/wrappers:task_wrapper",
        "@pip//absl_py",
    ],
)

# Packaging rules for PyPI release

py_package(
    name = "android_env_pkg",
    packages = ["android_env"],
    deps = [
        ":loader",
        "//android_env/components:android_device_loader",
        "//android_env/mcp:android_mcp_tools",
        "//android_env/playground:playground_lib",
        "//android_env/rl:environment",
        "//android_env/wrappers:discrete_action_wrapper",
        "//android_env/wrappers:flat_interface_wrapper",
        "//android_env/wrappers:float_pixels_wrapper",
        "//android_env/wrappers:gym_wrapper",
        "//android_env/wrappers:image_rescale_wrapper",
        "//android_env/wrappers:last_action_wrapper",
        "//android_env/wrappers:rate_limit_wrapper",
        "//android_env/wrappers:swipe_action_wrapper",
        "//android_env/wrappers:tap_action_wrapper",
        "//android_env/wrappers:task_wrapper",
    ],
)

py_wheel(
    name = "android_env_wheel",
    author = "DeepMind",
    distribution = "android_env",
    extra_requires = {
        "gym": ["gymnasium>=0.29.1"],
        "mcp": ["mcp>=1.26,<2"],
        "playground": ["ml-collections"],
    },
    license = "Apache License, Version 2.0",
    requires = [
        "absl-py>=2.1.0",
        "dm-env>=1.6",
        "numpy>=2.1.0",
        "portpicker>=1.6.0",
        "pillow>=10.4.0",
        "protobuf>=6,<8",
        "opencv-python-headless>=4.10.0",
        "websocket-client>=1.8.0",
    ],
    summary = "AndroidEnv: A Gym/Gymnasium Environment for Android",
    version = "2.0.0",
    deps = [":android_env_pkg"],
)
