load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "fake_simulator",
    srcs = ["fake_simulator.py"],
    deps = [
        "//android_env/components:adb_controller",
        "//android_env/components:config_classes",
        "//android_env/components:fake_log_stream",
        "//android_env/components:log_stream",
        "//android_env/components/simulators:base_simulator",
        "@pip//absl_py",
        "@pip//numpy",
    ],
)

py_test(
    name = "fake_simulator_test",
    srcs = ["fake_simulator_test.py"],
    deps = [
        ":fake_simulator",
        "//android_env/components:config_classes",
        "@pip//absl_py",
        "@pip//numpy",
    ],
)
