# proto-file: android_env/proto/task.proto
# proto-message: android_env.Task

# 1. Verify device state
setup_steps {
  adb_request {
    generic {
      args: "get-state"
    }
  }
}

# 2. Grant Media Projection permission
setup_steps {
  adb_request {
    generic {
      args: "shell"
      args: "cmd"
      args: "appops"
      args: "set"
      args: "com.google.androidenv.core"
      args: "PROJECT_MEDIA"
      args: "allow"
    }
  }
}

# 3. Enable Accessibility Service
setup_steps {
  adb_request {
    settings {
      name_space: SECURE
      put {
        key: "enabled_accessibility_services"
        value: "com.google.androidenv.core/com.google.androidenv.core.InputService"
      }
    }
  }
}
setup_steps {
  adb_request {
    settings {
      name_space: SECURE
      put {
        key: "accessibility_enabled"
        value: "1"
      }
    }
  }
}

# 4. Enable show touches
setup_steps {
  adb_request {
    settings {
      name_space: SYSTEM
      put {
        key: "show_touches"
        value: "1"
      }
    }
  }
}

# 5. Clear logcat and start MainActivity SERVER
setup_steps {
  adb_request {
    generic {
      args: "logcat"
      args: "-c"
    }
  }
}
setup_steps {
  adb_request {
    start_activity {
      full_activity: "com.google.androidenv.core/.MainActivity"
      extra_args: "--es"
      extra_args: "COMMAND"
      extra_args: "START_SERVER"
    }
  }
  success_condition {
    check_dumpsys {
      service: "accessibility"
      expected_string: "Input Service"
      timeout_sec: 30.0
    }
  }
}
