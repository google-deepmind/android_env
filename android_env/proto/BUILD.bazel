load("@rules_proto//proto:defs.bzl", "proto_library")
load("//:py_proto_library.bzl", "py_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "adb_proto",
    srcs = ["adb.proto"],
)

py_proto_library(
    name = "adb_py_pb2",
    srcs = ["adb.proto"],
)

proto_library(
    name = "task_proto",
    srcs = ["task.proto"],
    deps = [":adb_proto"],
)

py_proto_library(
    name = "task_py_pb2",
    srcs = ["task.proto"],
    proto_srcs = ["adb.proto"],
    deps = [":adb_py_pb2"],
)

proto_library(
    name = "device_env_service_proto",
    srcs = ["device_env_service.proto"],
    deps = [
        "//android_env/proto/a11y:a11y_proto",
        "//android_env/proto/a11y:android_accessibility_forest_proto",
    ],
)

py_proto_library(
    name = "device_env_service_py_pb2",
    srcs = ["device_env_service.proto"],
    proto_srcs = [
        "//android_env/proto/a11y:a11y.proto",
        "//android_env/proto/a11y:android_accessibility_action.proto",
        "//android_env/proto/a11y:android_accessibility_forest.proto",
        "//android_env/proto/a11y:android_accessibility_node_info.proto",
        "//android_env/proto/a11y:android_accessibility_node_info_clickable_span.proto",
        "//android_env/proto/a11y:android_accessibility_tree.proto",
        "//android_env/proto/a11y:android_accessibility_window_info.proto",
        "//android_env/proto/a11y:rect.proto",
    ],
    deps = [
        "//android_env/proto/a11y:a11y_py_pb2",
        "//android_env/proto/a11y:android_accessibility_forest_py_pb2",
    ],
)
