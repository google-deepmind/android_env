load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//android_env/playground:__subpackages__"])

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "frontend_ts",
    srcs = [
        "adb_console.ts",
        "controls.ts",
        "logs_viewer.ts",
        "main.ts",
        "socket.ts",
        "stats.ts",
        "task_loader.ts",
        "theme.ts",
    ],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig.json",
    deps = [":node_modules/safevalues"],
)

esbuild(
    name = "main_bin",
    srcs = [
        ":frontend_ts",
        ":node_modules/safevalues",
    ],
    entry_point = "main.js",
    format = "iife",
    minify = True,
    output = "main_bin.js",
    target = "es2022",
)

filegroup(
    name = "frontend",
    srcs = [
        "index.html",
        ":main_bin.js",
    ],
    visibility = ["//visibility:public"],
)
